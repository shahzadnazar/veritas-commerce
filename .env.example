# ── Application ───────────────────────────────────────────────────────────
# Domain, legal entity and branding are configuration, never hard-coded in
# application logic. Development placeholders are fine; production values
# are supplied at deploy time.
APP_NAME="Veritas Commerce"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_LOCALE=en

# ── Platform identity (mirrored into platform_settings on seed) ───────────
VERITAS_LEGAL_NAME="Veritas Commerce, Inc."
VERITAS_DISPLAY_NAME="Veritas Commerce"
VERITAS_SUPPORT_EMAIL=support@veritas.test
VERITAS_BILLING_EMAIL=billing@veritas.test
VERITAS_SENDER_EMAIL=orders@veritas.test
VERITAS_SENDER_NAME="Veritas Commerce"
VERITAS_BUSINESS_ADDRESS="1 Placeholder Way, Portland, OR 97232"
VERITAS_COUNTRY=US
VERITAS_TIMEZONE=UTC
VERITAS_DEFAULT_CURRENCY=USD
VERITAS_PUBLIC_URL=http://localhost:8000

# ── Branding (placeholders until real assets are supplied) ────────────────
VERITAS_LOGO_PATH=
VERITAS_FAVICON_PATH=
VERITAS_EMAIL_LOGO_PATH=
VERITAS_EMAIL_ACCENT="#ec3013"

# ── Media storage (R2 in production; a local disk in development) ─────────
VERITAS_MEDIA_DISK=public
VERITAS_MAX_UPLOAD_KB=5120

# ── Seller onboarding ─────────────────────────────────────────────────────
# Comma-separated document keys; empty means none are mandatory yet.
VERITAS_REQUIRED_SELLER_DOCUMENTS=
VERITAS_INVITATION_EXPIRY_DAYS=14

# ── Marketplace policy ────────────────────────────────────────────────────
# The clearing period is configuration. Never write "+7 days" in code.
VERITAS_SELLER_CLEARING_PERIOD_DAYS=7
VERITAS_DEFAULT_COMMISSION_RATE=12.00
VERITAS_MINIMUM_PAYOUT_MINOR=5000
VERITAS_LOW_STOCK_THRESHOLD=5
VERITAS_RESERVATION_TTL_MINUTES=20

# ── Database ──────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=veritas
DB_USERNAME=veritas
DB_PASSWORD=veritas

# How long a web request may hold the database, in milliseconds.
#
# PostgreSQL ships all three of these disabled, meaning "wait forever" —
# and forever is how one slow query becomes an outage: with a hundred
# connections available, a handful of unbounded statements exhausts the
# pool and every other request queues behind them. A page nobody is
# waiting for any more should stop costing a connection.
#
# Console processes are exempt from the first two: migrations, backups and
# the analytics rebuild are supposed to take minutes.
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
#
# This one applies everywhere. It fires only on a session doing nothing
# inside an open transaction — which no legitimate path does for a minute,
# and a crashed worker does forever, holding its locks and blocking VACUUM
# the whole time.
DB_IDLE_TRANSACTION_TIMEOUT_MS=60000
#
# Set any of them to 0 to disable that limit.

# Databases that refuse to be dropped, truncated or restored over.
#
# `migrate:fresh`, `migrate:refresh`, `db:wipe` and ops/restore-drill.sh
# all announce the database they are about to destroy, and refuse outright
# on anything named here. APP_ENV=production is refused whether it appears
# here or not.
#
# Comma-separated. Fill it in with the databases this machine must never
# lose — on a developer machine that means the development database, which
# is exactly the one M9 lost. The default is empty because a name baked
# into the repository would be wrong on every machine but one.
VERITAS_PROTECTED_DATABASES=
#
# The only way past that refusal, set inline on the one command that means
# it — never exported into a shell profile:
#
#   VERITAS_ALLOW_DESTRUCTIVE_DB=1 php artisan migrate:fresh

# ── Redis / cache / queue / session ───────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
# Staff sessions expire far sooner than customer sessions. Enforced as
# IDLE time by the admin.idle middleware: an administrator working through
# a review queue is not thrown out mid-review, one who walked away is.
ADMIN_SESSION_LIFETIME=30

# The session cookie must never travel over plain HTTP in production.
# `app:production-check` FAILS the deploy when this is not true, so a
# deployment that forgets it does not start — but it belongs here so
# nobody has to discover that from a failing gate.
SESSION_SECURE_COOKIE=true

# ── Mail ──────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="orders@veritas.test"
MAIL_FROM_NAME="${APP_NAME}"

# ── Providers (abstractions; no vendor coupling in the domain) ────────────
# `fake` runs the in-memory provider: no credentials, no network, and the
# default for local work, tests and CI. `stripe` needs all three values
# below, from the Stripe dashboard. Never commit real keys.
PAYMENT_PROVIDER=fake
PAYMENT_GATEWAY=fake
STRIPE_KEY=pk_test_replace_me
STRIPE_SECRET=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

FILESYSTEM_DISK=local
SEARCH_DRIVER=database

LOG_CHANNEL=stack
LOG_LEVEL=debug
VITE_APP_NAME="${APP_NAME}"

# Object storage.
#
# Development writes to the local disk. Production sets the driver to s3
# and points it at S3-compatible object storage (the architecture targets
# Cloudflare R2, but nothing in the code knows that). Media is public and
# CDN-fronted; documents are private with no public route at all.
VERITAS_STORAGE_DRIVER=local
VERITAS_STORAGE_ENDPOINT=
VERITAS_STORAGE_REGION=auto
VERITAS_STORAGE_KEY=
VERITAS_STORAGE_SECRET=
VERITAS_STORAGE_PATH_STYLE=false
VERITAS_MEDIA_BUCKET=
VERITAS_DOCUMENT_BUCKET=
VERITAS_MEDIA_URL=
VERITAS_MAX_DOCUMENT_KB=10240
VERITAS_SIGNED_URL_SECONDS=120
