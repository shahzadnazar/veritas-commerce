# The full configuration: everything shared plus Larastan's Laravel
# extension, which resolves Eloquent model properties, query builder
# returns and facade roots. Selected automatically by tools/phpstan.php
# when vendor/larastan/larastan is installed, which is the case on CI.
includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan.base.neon

parameters:
    # With Larastan present, model properties are knowable, so the check
    # that the base configuration cannot make is turned on.
    checkModelProperties: true
