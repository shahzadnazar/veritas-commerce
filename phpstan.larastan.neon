# The full configuration: everything in phpstan.neon plus Larastan's
# Laravel extension, which resolves Eloquent model properties, query
# builder returns and facade roots. Selected automatically by
# tools/phpstan.php when vendor/larastan/larastan is installed.
includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan.neon

parameters:
    # With Larastan present, model properties are knowable, so the check
    # that the base configuration has to disable is turned back on.
    checkModelProperties: true
