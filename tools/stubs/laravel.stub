<?php

/*
 * Stubs for Laravel APIs whose types come from runtime resolution.
 *
 * These are facts Larastan derives by reflecting the framework, declared
 * here so the analysis stays meaningful without it. Each narrows a type
 * that is certain at runtime; none widens or silences anything.
 */

namespace Illuminate\Database\Eloquent;

/**
 * @method static static|null find(mixed $id, array<int, string> $columns = ['*'])
 * @method static static findOrFail(mixed $id, array<int, string> $columns = ['*'])
 * @method static static create(array<string, mixed> $attributes = [])
 */
abstract class Model {}

namespace Illuminate\Testing;

/**
 * Inertia registers its assertion as a TestResponse macro.
 *
 * getContent() comes from the response the class wraps, which the stub
 * does not carry — it is declared here for the same reason as the rest:
 * it exists at runtime, and analysis should know it.
 *
 * @method self assertInertia(\Closure $callback)
 * @method string|false getContent()
 */
class TestResponse {}
