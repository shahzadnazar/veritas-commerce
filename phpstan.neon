# Analysis WITHOUT Larastan.
#
# Used when vendor/larastan is absent — see docs/architecture/M1-REPORT.md
# for why one environment cannot install it. CI installs it normally and
# runs phpstan.larastan.neon, so nothing here can hide a finding from CI.
includes:
    - phpstan.base.neon

parameters:
    # Level 6, not the 8 the base sets.
    #
    # Level 8 is about nullability, and without Larastan nothing here knows
    # that a relation returns a model or that a query returns a collection
    # of one — every Eloquent call degrades to stdClass or mixed. The 279
    # findings that produces are artefacts of the missing extension, not
    # defects, and stubbing around them would mean re-declaring most of
    # Eloquent. CI runs phpstan.larastan.neon at level 8 with zero errors;
    # this exists so analysis still runs where Larastan cannot install.
    level: 6

    # Larastan ships its own Model stub; this one stands in for it.
    stubFiles:
        - tools/stubs/eloquent.stub

    # Every entry below is a place where Eloquent's generics do not resolve
    # without Larastan, so a query's element type degrades to stdClass and a
    # relation's nullability is guessed. None is ignored in
    # phpstan.larastan.neon, which is the configuration CI runs.
    #
    # Acting on them here would be actively harmful: rewriting a `?->` that
    # PHPStan believes is redundant would introduce a null dereference the
    # moment the relation really is empty.
    ignoreErrors:
        -
            identifier: nullsafe.neverNull
            reportUnmatched: false
        -
            identifier: method.nonObject
            reportUnmatched: false
            message: '#Cannot call method \w+\(\) on stdClass#'
        -
            identifier: argument.type
            reportUnmatched: false
            message: '#Collection<int,stdClass>::map#'

    reportUnmatchedIgnoredErrors: false
